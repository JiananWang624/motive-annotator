      },
      {
        "name": "transfer_end",
        "label": "Transfer End",
        "hotkey": "<ctrl>+<alt>+x"
      },
      {
        "name": "withdrawal_start",
        "label": "Withdrawal Start",
        "hotkey": "<ctrl>+<alt>+c"
